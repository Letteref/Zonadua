{
  "name": "zonadua",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "Zonadua — local-first cycling performance, route estimation and race-day tracking PWA",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:all": "npm run test && npm run test:e2e",
    "audit:lighthouse": "npm run build && node scripts/audit-lighthouse.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "deploy:prod": "wrangler pages deploy dist --project-name zonadua --branch master"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/svelte": "^1.1.5",
    "dexie": "^4.4.6",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.4",
    "happy-dom": "^20.14.5",
    "lighthouse": "^11.7.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
